# For local dev, leave unset to use the default local SQLite file.
# For deployment (Render/Railway), set this to your managed Postgres URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT auth tokens. Any long random string works for
# local dev; generate a real one for deployment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-this-in-production
